<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <!-- 与 win/linux 的发布目录分开,三平台产物互不覆盖。路径用正斜杠:本 profile 只在 macOS 上用,
         而 win profile 里的反斜杠在非 Windows MSBuild 下会被当文件名字面量(见 AotLinuxX64 的同类注释)。 -->
    <PublishDir>bin/publish-aot-osx/</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <!-- 同 AotWinX64/AotLinuxX64:SDK 的 _CopyAotSymbols 在发布收尾把几十 MB 的符号拷进发布目录,
         从源头关掉,发布目录只剩 exe + THIRD-PARTY-NOTICES.txt。 -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
</Project>
