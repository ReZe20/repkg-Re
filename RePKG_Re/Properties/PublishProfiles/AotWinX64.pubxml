<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\publish-aot\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <!-- 关掉 AOT 符号拷贝:SDK 的 _CopyAotSymbols(AfterTargets=Publish)会把几十 MB 的原生 pdb
         在发布收尾拷进发布目录,且晚于项目自身的清理目标(pubxml 晚于 csproj 求值,
         csproj 里那份同属性只覆盖纯 CLI -p:PublishAot 路径)。obj 里的 pdb 不受影响。 -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
</Project>
