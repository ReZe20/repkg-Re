<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net472</TargetFramework>
  </PropertyGroup>

  <!-- 发布后清理：只保留 exe 与 THIRD-PARTY-NOTICES.txt（依赖已由 Costura 内嵌） -->
  <Target Name="CleanPublishOutput" AfterTargets="Publish">
    <ItemGroup>
      <FilesToRemove Include="$(PublishDir)*.dll;$(PublishDir)*.pdb;$(PublishDir)*.config;$(PublishDir)*.json" />
    </ItemGroup>
    <Delete Files="@(FilesToRemove)" />
  </Target>
</Project>
