<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>RePKG_Re</RootNamespace>
        <AssemblyName>RePKG_Re</AssemblyName>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Version>0.5.4</Version>
        <Authors>NotScuffed, ReZe20</Authors>
        <Copyright>Copyright © NotScuffed 2019-2025, ReZe20 2026</Copyright>
    </PropertyGroup>

    <!-- AOT 原生 pdb(几十 MB)由 SDK 的 _CopyAotSymbols(AfterTargets=Publish)在发布收尾拷进发布目录,
         与项目自身的清理目标相对顺序不可靠(实测 SDK 的排在后面 → 删了又被拷回来)。
         直接关符号拷贝,发布目录根本不产生 pdb;obj 里的 pdb 不受影响。 -->
    <PropertyGroup Condition="'$(PublishAot)' == 'true'">
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    </PropertyGroup>

    <!-- AOT 发布目录里连托管 pdb 也不留(RePKG_Re.Cli/.Application/.Core 三份)。
         release.yml 是 Compress-Archive publish-aot/* 整目录打包,留着就是发布包里白装三个文件。
         上面那条只管原生符号,这三份走的是发布清单,所以在清单成型后剔掉;
         只在 PublishAot 时剔——普通 build 与框架依赖发布仍产 pdb 供调试。 -->
    <Target Name="DropManagedPdbFromAotPublish" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(PublishAot)' == 'true'">
        <ItemGroup>
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <ProjectReference Include="..\RePKG_Re.Cli\RePKG_Re.Cli.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(ProjectDir)/../THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
