<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>RePKG_Re</RootNamespace>
        <AssemblyName>RePKG_Re</AssemblyName>
        <OutputType>Exe</OutputType>
        <TargetFramework>net472</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Version>0.4.3</Version>
        <Authors>NotScuffed, ReZe20</Authors>
        <Copyright>Copyright © NotScuffed 2019-2025, ReZe20 2026</Copyright>
    </PropertyGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\RePKG_Re.Application\RePKG_Re.Application.csproj" />
        <ProjectReference Include="..\RePKG_Re.Core\RePKG_Re.Core.csproj" />
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="CommandLineParser" Version="2.9.1" />
        <PackageReference Include="Costura.Fody" Version="6.2.0" PrivateAssets="All" />
    </ItemGroup>
    
    <ItemGroup>
      <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(ProjectDir)/../THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- 发布后清理：只保留 exe 与 THIRD-PARTY-NOTICES.txt（依赖已由 Costura 内嵌）。
         放在 csproj 而非 pubxml，确保 VS 发布（MSBuild）与命令行发布（dotnet publish）都生效 -->
    <Target Name="CleanPublishOutput" AfterTargets="Publish">
        <ItemGroup>
            <FilesToRemove Include="$(PublishDir)*.dll;$(PublishDir)*.pdb;$(PublishDir)*.config;$(PublishDir)*.json" />
        </ItemGroup>
        <Delete Files="@(FilesToRemove)" />
    </Target>
</Project>